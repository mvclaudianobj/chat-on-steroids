{
  "engine": "claude",
  "note": "Synthetic Claude Code 2.1.x stream-json turn, already translated to EngineEvents. Tool ids are tool_use ids; the approval is a can_use_tool control_request.",
  "steps": [
    { "from": "stream_event content_block_delta text_delta", "event": { "type": "text_delta", "delta": "Let me look at the README." } },
    { "from": "assistant tool_use Read", "event": { "type": "tool_started", "toolId": "toolu_01", "kind": "read", "name": "Read", "path": "/work/app/README.md", "input": { "file_path": "/work/app/README.md" } } },
    { "from": "user tool_result toolu_01", "event": { "type": "tool_finished", "toolId": "toolu_01", "status": "ok", "output": "# App\nRun npm start." } },
    { "from": "assistant tool_use Bash", "event": { "type": "tool_started", "toolId": "toolu_02", "kind": "command", "name": "Bash", "command": "rm -rf build", "input": { "command": "rm -rf build" } } },
    { "from": "control_request can_use_tool request_id req-1", "event": { "type": "approval_requested", "requestId": "req-1", "toolId": "toolu_02", "kind": "command", "tool": "Bash", "summary": "rm -rf build", "action": { "command": "rm -rf build" } } },
    { "from": "user tool_result toolu_02 is_error (denied)", "event": { "type": "tool_finished", "toolId": "toolu_02", "status": "declined" } },
    { "from": "stream_event text_delta", "event": { "type": "text_delta", "delta": "I left the build folder alone." } },
    { "from": "result{subtype:success,usage}", "event": { "type": "usage", "inputTokens": 3000, "outputTokens": 120 } },
    { "from": "result{subtype:success}", "event": { "type": "turn_end", "outcome": "completed" } }
  ]
}
