{
  "engine": "opencode",
  "note": "Synthetic OpenCode 1.19 /global/event turn, already translated to EngineEvents. The permission is answered in the TUI attached to the same session, then the run is aborted there.",
  "steps": [
    { "from": "message.part.delta {field:text}", "event": { "type": "text_delta", "delta": "Running the formatter." } },
    { "from": "message.part.updated tool bash running", "event": { "type": "tool_started", "toolId": "call-1", "kind": "command", "name": "bash", "command": "npm run format" } },
    { "from": "message.part.updated tool bash running {metadata.output}", "event": { "type": "tool_output", "toolId": "call-1", "chunk": "formatted 3 files\n" } },
    { "from": "message.part.updated tool bash completed {metadata.exit:0}", "event": { "type": "tool_finished", "toolId": "call-1", "status": "ok", "exitCode": 0 } },
    { "from": "permission.asked{id:per_1,permission:edit,patterns}", "event": { "type": "approval_requested", "requestId": "per_1", "toolId": "call-2", "kind": "patch", "tool": "edit", "summary": "Edit src/a.ts", "files": ["src/a.ts"], "action": { "permission": "edit", "patterns": ["src/a.ts"] } } },
    { "from": "permission.replied{requestID:per_1} (answered in the TUI)", "event": { "type": "approval_resolved", "requestId": "per_1" } },
    { "from": "message.part.updated tool edit running", "event": { "type": "tool_started", "toolId": "call-2", "kind": "patch", "name": "edit", "files": [{ "path": "src/a.ts", "kind": "update" }] } },
    { "from": "session.status retry (provider overloaded)", "event": { "type": "error", "message": "The provider is overloaded; retrying." } },
    { "from": "session.error MessageAbortedError + session.status idle", "event": { "type": "turn_end", "outcome": "stopped", "detail": "Stopped from the OpenCode terminal" } },
    { "from": "message.part.updated tool edit completed (after the end: ignored)", "event": { "type": "tool_finished", "toolId": "call-2", "status": "ok" } }
  ]
}
