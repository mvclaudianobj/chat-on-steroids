{
  "engine": "markscode",
  "note": "Synthetic MarksCode 2.0.25 SSE turn (/api/event), already translated to EngineEvents. The permission is answered in the TUI attached to the same session, then the user stops the turn.",
  "steps": [
    { "from": "session.text.delta", "event": { "type": "text_delta", "delta": "Running the formatter." } },
    { "from": "session.shell.started", "event": { "type": "tool_started", "toolId": "call-1", "kind": "command", "name": "shell", "command": "npm run format" } },
    { "from": "session.shell.output", "event": { "type": "tool_output", "toolId": "call-1", "chunk": "formatted 3 files\n" } },
    { "from": "session.shell.succeeded", "event": { "type": "tool_finished", "toolId": "call-1", "status": "ok", "exitCode": 0 } },
    { "from": "permission.asked{id:perm-1,action:edit,resources}", "event": { "type": "approval_requested", "requestId": "perm-1", "toolId": "call-2", "kind": "patch", "tool": "edit", "summary": "edit src/a.ts", "files": ["update src/a.ts"], "action": { "action": "edit", "resources": ["src/a.ts"] } } },
    { "from": "permission.replied{id:perm-1} (answered in the TUI)", "event": { "type": "approval_resolved", "requestId": "perm-1" } },
    { "from": "session.tool.called edit", "event": { "type": "tool_started", "toolId": "call-2", "kind": "patch", "name": "edit", "files": [{ "path": "src/a.ts", "kind": "update" }] } },
    { "from": "error (provider overloaded, retrying)", "event": { "type": "error", "message": "The provider is overloaded; retrying." } },
    { "from": "session.execution.interrupted", "event": { "type": "turn_end", "outcome": "stopped", "detail": "Stopped from the MarksCode terminal" } },
    { "from": "session.tool.success call-2 (after the end: ignored)", "event": { "type": "tool_finished", "toolId": "call-2", "status": "ok" } }
  ]
}
